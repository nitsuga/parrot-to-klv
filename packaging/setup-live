set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
IMAGE_TAG='@IMAGE_TAG@'
IMAGE_FILE="$HERE/@IMAGE_FILE@"

usage() {
  echo "Usage: $(basename "$0")"
  echo "Interactively configure and optionally start the live Compose service."
}

fail() {
  echo "error: $*" >&2
  exit 1
}

ask() {
  prompt=$1
  default=$2
  if [ -n "$default" ]; then
    printf '%s [%s]: ' "$prompt" "$default"
  else
    printf '%s: ' "$prompt"
  fi
  IFS= read -r REPLY || fail "input ended before setup was complete"
  [ -n "$REPLY" ] || REPLY=$default
}

confirm() {
  prompt=$1
  default=$2
  if [ "$default" = y ]; then suffix='[Y/n]'; else suffix='[y/N]'; fi
  printf '%s %s: ' "$prompt" "$suffix"
  IFS= read -r REPLY || fail "input ended before setup was complete"
  case "$REPLY" in
    [Yy]*) return 0 ;;
    [Nn]*) return 1 ;;
    '') [ "$default" = y ] ;;
    *) echo "Please answer y or n." >&2; confirm "$prompt" "$default" ;;
  esac
}

quote_env() {
  printf %s "$1" | sed "s/'/\\\\'/g"
}

case ${1-} in
  -h|--help) usage; exit 0 ;;
  '') ;;
  *) usage >&2; exit 2 ;;
esac

[ "$(uname -s)" = Linux ] || fail "the live Compose service requires Linux host networking"
command -v docker >/dev/null 2>&1 || fail "docker is not installed"
docker compose version >/dev/null 2>&1 || fail "the Docker Compose plugin is not installed"
docker info >/dev/null 2>&1 || fail "cannot reach the Docker daemon; start Docker and check your access"

cd "$HERE"

cat <<'EOF'
Live ingest shares the host network namespace so --iface can select a real
host NIC. This removes Docker's network isolation. The service restarts after
any exit until you explicitly run `docker compose stop` or `down`.
Stopping is graceful and can take up to 5 minutes 30 seconds.

An RTSP URI may contain credentials. Setup stores .env with mode 0600, but the
URI can still appear in Docker process metadata and error logs.
EOF

confirm "Continue" n || exit 0

configure=y
if [ -e .env ]; then
  if confirm "Keep the existing .env configuration" y; then
    configure=n
  fi
fi

if [ "$configure" = n ]; then
  chmod 600 .env || fail "could not make .env private"
  if grep -q '^IMAGE_TAG=.' .env; then
    echo "The existing .env pins an older image instead of this release."
    confirm "Update IMAGE_TAG to follow this release" y || exit 0
    umask 077
    tmp=$(mktemp "$HERE/.env.tmp.XXXXXX")
    trap 'rm -f -- "$tmp"' EXIT HUP INT TERM
    sed 's/^IMAGE_TAG=.*/IMAGE_TAG=/' .env > "$tmp"
    mv -- "$tmp" .env
    trap - EXIT HUP INT TERM
  fi
fi

if [ "$configure" = y ]; then
while :; do
  ask "RTSP URI (rtsp:// or rtsps://)" ""
  case "$REPLY" in
    rtsp://*|rtsps://*) RTSP_URI=$REPLY; break ;;
    *) echo "Enter an rtsp:// or rtsps:// URI." >&2 ;;
  esac
done

cat <<'EOF'
The sink may be a file under /out, or a udp:// or srt:// address. File sessions
become numbered captures; network sinks stream directly and create no capture.
EOF
while :; do
  ask "Output sink" "/out/capture.ts"
  case "$REPLY" in
    /out/*|udp:*|srt:*) SINK=$REPLY; break ;;
    *) echo "Use a path under /out, or a udp:// or srt:// address." >&2 ;;
  esac
done

ask "Host capture directory" "./captures"
OUTPUT_DIR=$REPLY
mkdir -p -- "$OUTPUT_DIR" || fail "could not create output directory: $OUTPUT_DIR"
[ -d "$OUTPUT_DIR" ] && [ -w "$OUTPUT_DIR" ] || fail "output directory is not writable: $OUTPUT_DIR"

echo "Idle timeout ends a session after that many quiet seconds; 0 disables it."
while :; do
  ask "Idle timeout in seconds" "10"
  case "$REPLY" in
    *[!0-9]*|'') echo "Enter a whole number 0 or greater." >&2 ;;
    *) IDLE_TIMEOUT=$REPLY; break ;;
  esac
done

cat <<'EOF'
The empty-session limit ends one failing process, but Compose then restarts it
with a fresh counter; 0 disables the limit.
EOF
while :; do
  ask "Maximum consecutive empty sessions" "5"
  case "$REPLY" in
    *[!0-9]*|'') echo "Enter a whole number 0 or greater." >&2 ;;
    *) MAX_EMPTY_SESSIONS=$REPLY; break ;;
  esac
done

HOST_UID=$(id -u)
HOST_GID=$(id -g)
umask 077
tmp=$(mktemp "$HERE/.env.tmp.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT HUP INT TERM
{
  echo '# Generated by setup-live. Run it again to replace this file.'
  echo 'IMAGE_TAG='
  printf "RTSP_URI='%s'\n" "$(quote_env "$RTSP_URI")"
  printf "SINK='%s'\n" "$(quote_env "$SINK")"
  printf 'IDLE_TIMEOUT=%s\n' "$IDLE_TIMEOUT"
  printf 'MAX_EMPTY_SESSIONS=%s\n' "$MAX_EMPTY_SESSIONS"
  printf "OUTPUT_DIR='%s'\n" "$(quote_env "$OUTPUT_DIR")"
  printf 'HOST_UID=%s\nHOST_GID=%s\n' "$HOST_UID" "$HOST_GID"
} > "$tmp"
mv -- "$tmp" .env
trap - EXIT HUP INT TERM
fi

docker compose config >/dev/null || fail "the Compose configuration is invalid"
if [ "$configure" = y ]; then
  echo "Configuration written to $HERE/.env"
else
  echo "Using existing configuration in $HERE/.env"
fi

replaced_image_id=
if docker image inspect "$IMAGE_TAG" >/dev/null 2>&1; then
  if [ -f "$IMAGE_FILE" ] && confirm "Reload $IMAGE_TAG from the bundled image" y; then
    replaced_image_id=$(docker image inspect --format '{{.Id}}' "$IMAGE_TAG")
    echo "Reloading $IMAGE_TAG..."
    docker load -i "$IMAGE_FILE" >/dev/null
    loaded_image_id=$(docker image inspect --format '{{.Id}}' "$IMAGE_TAG")
    [ "$loaded_image_id" = "$replaced_image_id" ] && replaced_image_id=
  fi
else
  [ -f "$IMAGE_FILE" ] || fail "image $IMAGE_TAG is not loaded and $IMAGE_FILE is missing"
  echo "Loading $IMAGE_TAG..."
  docker load -i "$IMAGE_FILE" >/dev/null
fi

if confirm "Start live ingest now" y; then
  existing=$(docker ps -a --filter label=com.docker.compose.service=ingest \
    --format '{{.ID}} {{.Image}} {{.Names}}' | awk '$2 ~ /^parrot-to-klv:/')
  if [ -n "$existing" ]; then
    echo "Existing parrot-to-klv Compose ingest containers:"
    printf '  %s\n' "$existing"
    confirm "Stop and replace these containers" n || fail "existing live ingest left running"
    printf '%s\n' "$existing" | awk '{print $1}' | while IFS= read -r container; do
      docker stop --timeout 330 "$container" >/dev/null
      docker rm "$container" >/dev/null
    done
  fi

  docker compose up -d --force-recreate
  echo "Started. Follow it with:  docker compose logs -f ingest"
  echo "Stop it with:            docker compose stop"

  image_arch=${IMAGE_TAG##*-}
  old_images=$(docker image ls parrot-to-klv --format '{{.Repository}}:{{.Tag}}' |
    awk -v current="$IMAGE_TAG" -v suffix="-$image_arch" \
      '$0 != current && substr($0, length($0) - length(suffix) + 1) == suffix')
  if [ -n "$old_images" ]; then
    echo "Older parrot-to-klv image tags:"
    printf '  %s\n' "$old_images"
    if confirm "Remove these old image tags" n; then
      printf '%s\n' "$old_images" | while IFS= read -r image; do
        docker image rm "$image" >/dev/null ||
          echo "warning: could not remove image still in use: $image" >&2
      done
    fi
  fi
  if [ -n "$replaced_image_id" ]; then
    docker image rm "$replaced_image_id" >/dev/null 2>&1 ||
      echo "warning: replaced image is still in use: $replaced_image_id" >&2
  fi
fi
