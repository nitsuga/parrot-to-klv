# Live-session settings for compose.yml — copy to .env and edit.
# Staged for parrot-to-klv @VERSION@ (@ARCH@). Leave IMAGE_TAG blank to use the
# image shipped beside this file; set it only to deliberately override that.
IMAGE_TAG=

# The live source. No default — set this to the drone or server to capture.
# Single-quote a credentialed URI so `$` in a password stays literal.
RTSP_URI=

# Where the capture goes: a file under /out (kept in OUTPUT_DIR on the host),
# or a live udp:// or srt:// address.
SINK=/out/capture.ts

# End a session after this many seconds with no video delivered (0 disables);
# in --reconnect (always on here) each session finalizes its own capture.
IDLE_TIMEOUT=10

# End one process after this many consecutive sessions that opened yet delivered
# no video or telemetry. Compose then restarts it with a fresh counter; a source
# that never opens keeps being retried.
MAX_EMPTY_SESSIONS=5

# Host directory kept as /out in the container. Create it before the first
# `docker compose up` (`mkdir -p ./captures`); Compose fails rather than
# creating a missing directory as root.
OUTPUT_DIR=./captures

# Output ownership: the service runs as HOST_UID:HOST_GID so captures belong
# to you rather than root — the caller-ownership boundary (ADR 0010), the
# compose spelling of the launcher's --user "$(id -u):$(id -g)". Both are
# required with no fallback: an unset ID fails `docker compose config` loudly
# instead of silently writing captures as the wrong user. setup-live fills
# these automatically; for manual setup, use the output of `id -u` and `id -g`.
# (The HOST_ names avoid bash's readonly UID, which `export` cannot set.) They
# live in the environment rather than only here so one checked-in file serves
# every user.
HOST_UID=
HOST_GID=

# UDP multicast output tuning — uncomment when SINK is a udp: address, and the
# matching --iface/--ttl lines in compose.yml.
# UDP_IFACE=eth1
# UDP_TTL=1
