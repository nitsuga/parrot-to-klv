# Live-session settings for compose.yml — copy to .env and edit.
# Staged for parrot-to-klv @VERSION@ (@ARCH@); IMAGE_TAG defaults to the image
# this file shipped beside, like the launcher beside it.
IMAGE_TAG=@IMAGE_TAG@

# The live source. No default — set this to the drone or server to capture.
RTSP_URI=rtsp://192.0.2.10/live

# Where the capture goes: a file under /out (kept in OUTPUT_DIR on the host),
# or a live udp:// or srt:// address.
SINK=/out/capture.ts

# End a session after this many seconds with no video delivered (0 disables);
# in --reconnect (always on here) each session finalizes its own capture.
IDLE_TIMEOUT=10

# Stop after this many consecutive sessions that opened yet delivered no video
# or telemetry; a source that never opens keeps being retried.
MAX_EMPTY_SESSIONS=5

# Host directory kept as /out in the container. Create it before the first
# `docker compose up` (mkdir -p ./captures): if it does not exist, the daemon
# creates it root-owned and the service — running as you, not root — cannot
# write to it.
OUTPUT_DIR=./captures

# Output ownership: the service runs as UID:GID so captures belong to you
# rather than root — the caller-ownership boundary (ADR 0010), the compose
# spelling of the launcher's --user "$(id -u):$(id -g)". Both come from your
# shell environment with a 1000 fallback when unset; pin them exactly by
# prefixing the compose invocation:
#   env UID=$(id -u) GID=$(id -g) docker compose up -d
# (export cannot set UID — it is readonly in bash.) They live in the
# environment rather than here so one checked-in file serves every user.

# UDP multicast output tuning — uncomment when SINK is a udp: address, and the
# matching --iface/--ttl lines in compose.yml.
# UDP_IFACE=eth0
# UDP_TTL=1
